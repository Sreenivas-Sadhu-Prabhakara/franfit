# FranFit environment
# Copy to .env and export, or set inline: PORT=8101 make run

# HTTP port the single binary listens on (API + UI).
PORT=8101

# --- Upgrade-to-live switches (documented, not yet wired) ---
# WhatsApp Business API token. When set, lead notifications to brand teams
# would go out via the live WhatsApp Cloud API instead of the deterministic
# mock (notify.MockWhatsApp). Leave unset to run fully offline with zero keys.
# FRANFIT_WHATSAPP_TOKEN=
# FRANFIT_WHATSAPP_PHONE_ID=
